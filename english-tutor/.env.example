# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交。

# qwen = 阿里云百炼 Qwen-Omni 实时语音；mock = 离线假模型（不花钱，先调通链路）
PROVIDER=qwen
# 百炼控制台 → API-KEY 管理 获取
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 模型：qwen3.8-omni-flash-realtime（最新）或 qwen3-omni-flash-realtime（上一代，官方价已核实）
MODEL=qwen3.8-omni-flash-realtime
# 北京地域；国际站改为 wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 音色，留空用默认（3.8 官方示例音色 longanlingxin；上一代默认 Cherry）
VOICE=

# server_vad = 免按键自动判断说完（可打断）；push_to_talk = 按住说话（最稳，适合低龄/吵闹环境）
TURN_MODE=server_vad
# 小孩声音小、停顿多：阈值低一点、静音时长长一点，避免话没说完就被截断
VAD_THRESHOLD=0.3
VAD_SILENCE_MS=900
VAD_PREFIX_MS=300

# 孩子信息（写进提示词）
CHILD_NAME=小朋友
CHILD_AGE=7
# beginner / elementary / intermediate
ENGLISH_LEVEL=beginner
TUTOR_NAME=Lily

HOST=0.0.0.0
PORT=8000
# 设备连接口令，OTA 时自动下发给设备；务必改成随机字符串
DEVICE_TOKEN=change-me
# 设备访问本服务的 WebSocket 地址，留空则按请求的 Host 自动生成
# PUBLIC_WS_URL=ws://192.168.1.10:8000/xiaozhi/v1/
